// Prepend this file to one detection query in an Azure Monitor Logs session.
// Each scenario has a user or IP that should alert and, where useful, one that should not.
let MakeSignIn = (NewId:string, User:string, Offset:timespan, Address:string,
                  Code:string, Country:string, Details:string, Coordinates:dynamic, Risk:string) {
    print TimeGenerated=now()-Offset, Id=NewId, UserId=User,
        UserPrincipalName=strcat(User, "@example.test"), IPAddress=Address,
        ResultType=Code, Location=Country, AuthenticationDetails=Details,
        LocationDetails=Coordinates, RiskLevelDuringSignIn=Risk, RiskEventTypes_V2="[]"
};
let DeniedPush = '[{"authenticationMethod":"Mobile app notification","succeeded":false}]';
let ApprovedPush = '[{"authenticationMethod":"Mobile app notification","succeeded":true}]';
let SigninLogs = union
    // Password spray: 5 accounts from 192.0.2.10, one of which then signs in (High)
    (range I from 1 to 5 step 1
        | project TimeGenerated=ago(5m), IPAddress="192.0.2.10", ResultType="50126",
            UserPrincipalName=strcat("spray", I, "@example.test")),
    (MakeSignIn("spray-ok", "spray3", 2m, "192.0.2.10", "0", "", "[]", dynamic(null), "none")),
    // Not a spray: one user mistyping a password 4 times
    (range I from 1 to 4 step 1
        | project TimeGenerated=ago(5m), IPAddress="192.0.2.20", ResultType="50126",
            UserPrincipalName="typo@example.test"),
    // MFA push flooding: 5 denied pushes for one user
    (range I from 1 to 5 step 1
        | project TimeGenerated=ago(5m), IPAddress="192.0.2.11", Id=strcat("push", I),
            UserId="mfa", UserPrincipalName="mfa@example.test", ResultType="500121",
            AuthenticationDetails=DeniedPush),
    // MFA fatigue success: 3 denied pushes, then an approved sign-in
    (range I from 1 to 3 step 1
        | project TimeGenerated=ago(20m) + I * 1m, IPAddress="192.0.2.21", Id=strcat("fatigue", I),
            UserId="fatigue", UserPrincipalName="fatigue@example.test", ResultType="500121",
            AuthenticationDetails=DeniedPush),
    (MakeSignIn("fatigue-ok", "fatigue", 10m, "192.0.2.21", "0", "", ApprovedPush, dynamic(null), "none")),
    // Not fatigue: one denied push, then success
    (MakeSignIn("slip1", "slip", 15m, "192.0.2.22", "500121", "", DeniedPush, dynamic(null), "none")),
    (MakeSignIn("slip-ok", "slip", 14m, "192.0.2.22", "0", "", ApprovedPush, dynamic(null), "none")),
    // New country and impossible travel: US two hours ago, GB ten minutes ago
    (MakeSignIn("us", "traveler", 2h, "192.0.2.12", "0", "US", "[]",
        dynamic({"geoCoordinates":{"latitude":40.7,"longitude":-74.0}}), "none")),
    (MakeSignIn("gb", "traveler", 10m, "192.0.2.13", "0", "GB", "[]",
        dynamic({"geoCoordinates":{"latitude":51.5,"longitude":-0.1}}), "none")),
    // High-risk successful sign-in, and a normal one
    (MakeSignIn("risk", "risky", 5m, "192.0.2.14", "0", "US", "[]", dynamic(null), "high")),
    (MakeSignIn("normal", "normal", 5m, "192.0.2.15", "0", "US", "[]", dynamic(null), "none"));
let OfficeActivity = datatable(UserId:string, ClientIP:string, OfficeWorkload:string,
                               Operation:string, Parameters:string, OperationProperties:string)
[
    "mail@example.test", "192.0.2.16", "Exchange", "New-InboxRule", '[{"Name":"ForwardTo","Value":"external@example.test"}]', "",
    "rss@example.test", "192.0.2.18", "Exchange", "New-InboxRule", '[{"Name":"MoveToFolder","Value":"RSS Subscriptions"},{"Name":"MarkAsRead","Value":"True"}]', "",
    "client@example.test", "192.0.2.19", "Exchange", "UpdateInboxRules", "", '[{"Name":"RuleActions","Value":"[{\\"ActionType\\":\\"Forward\\",\\"Recipients\\":[\\"external@example.test\\"]}]"}]',
    "normal@example.test", "192.0.2.17", "Exchange", "New-InboxRule", '[{"Name":"MoveToFolder","Value":"Receipts"}]', ""
]
| extend TimeGenerated=ago(5m);
