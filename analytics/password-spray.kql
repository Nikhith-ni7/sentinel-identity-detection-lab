// One IP failing against five or more accounts in 15 minutes.
// Counts bad passwords, Smart Lockout and unknown-user errors, and raises severity to High
// when the same IP also signs in successfully (a spray that worked).
let Window = 15m;
let FailureCodes = dynamic(["50126", "50053", "50056", "50034"]);
let Failures = SigninLogs
    | where TimeGenerated > ago(Window) and ResultType in (FailureCodes)
    | where isnotempty(IPAddress) and isnotempty(UserPrincipalName)
    | summarize FailedAttempts=count(), LockoutEvents=countif(ResultType == "50053"),
        Accounts=make_set(tolower(UserPrincipalName), 100),
        FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated)
        by IPAddress
    | extend AccountCount=array_length(Accounts)
    | where AccountCount >= 5;
let Successes = SigninLogs
    | where TimeGenerated > ago(Window) and ResultType == "0" and isnotempty(IPAddress)
    | summarize SuccessfulAccounts=make_set(tolower(UserPrincipalName), 100) by IPAddress;
Failures
| join kind=leftouter Successes on IPAddress
| extend SuccessfulAccounts=iff(isnull(SuccessfulAccounts), dynamic([]), SuccessfulAccounts)
| extend Severity=iff(array_length(SuccessfulAccounts) > 0, "High", "Medium")
| project LastSeen, IPAddress, AccountCount, FailedAttempts, LockoutEvents,
    Accounts, SuccessfulAccounts, Severity, FirstSeen
