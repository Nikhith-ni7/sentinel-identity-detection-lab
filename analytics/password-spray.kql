SigninLogs
| where TimeGenerated > ago(15m) and ResultType == "50126"
| where isnotempty(IPAddress) and isnotempty(UserPrincipalName)
| summarize FailedAttempts=count(), Accounts=make_set(tolower(UserPrincipalName), 100)
    by IPAddress
| extend AccountCount=array_length(Accounts)
| where AccountCount >= 5
